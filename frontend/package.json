{
  "name": "estudo-evangelhos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bible:generate": "node ../scripts/extrair_biblia_ave_maria.mjs",
    "content:generate": "node ../scripts/gerar_conteudo_estatico.mjs && node ../scripts/gerar_traducoes_estaticas.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-portable.mjs",
    "build:github": "npm run build && node scripts/publish-github.mjs",
    "preview": "vite preview",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint app src content --max-warnings=0"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
